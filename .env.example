# Modelo de configuracao - copie para .env e preencha com seus dados.
# O arquivo .env esta no .gitignore e NAO vai para o GitHub.

# Credenciais da sua aplicacao no Pluggy (https://dashboard.pluggy.ai)
PLUGGY_CLIENT_ID=seu_client_id
PLUGGY_CLIENT_SECRET=seu_client_secret

# Chave secreta usada para assinar os cookies de login (gere uma qualquer)
APP_SECRET=substitua_por_uma_chave_longa_e_aleatoria

# Opcional: modo da aplicacao (development | production)
# PLUGGY_MODE=development

# Opcional: endereco e porta do servidor
# HOST=127.0.0.1
# PORT=3000
